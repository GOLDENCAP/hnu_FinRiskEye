<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature android:name="android.hardware.camera" />
    <uses-feature android:name="android.hardware.camera.autofocus" />
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chapter07"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".my_audio_record_0829.my_record_audio_0829"
            android:exported="false" />
        <activity
            android:name=".my_opencv.my_opencv_all_activity_list"
            android:exported="false"
            android:label="OpenCV 功能列表" />
        <activity
            android:name=".my_opencv.get_picture_location.get_picture_location"
            android:exported="false"
            android:label="图片位置识别" />
        <activity
            android:name=".get_click_and_picture.GetClickAndPictureActivity"
            android:exported="false"
            android:label="点击并记录周围图片" />
        <activity
            android:name=".get_picture_around.GetPictureAroundActivity"
            android:exported="false"
            android:label="截取点击点附近图像" />
        <activity
            android:name=".rtsp_player.RtspPlayerActivity"
            android:exported="false"
            android:label="RTSP 视频播放器" />
        <activity
            android:name=".OpenCvDemoActivity"
            android:exported="false"
            android:label="OpenCV Java Demo" />
        <activity
            android:name=".myclick.myclick1"
            android:exported="false" />
        <activity
            android:name=".peer"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".getposition.get"
            android:exported="false" />
        <activity
            android:name=".getposition.AccessibilityDemoActivity"
            android:exported="false"
            android:label="无障碍服务演示" />
        <activity
            android:name=".getposition.ClickReplayActivity"
            android:exported="false"
            android:label="点击回放" />
        <activity
            android:name=".getposition.BackgroundReplayActivity"
            android:exported="false"
            android:label="后台点击回放" />
        <activity
            android:name=".getposition.BackgroundRecordActivity"
            android:exported="false"
            android:label="后台点击记录" />
        <activity
            android:name=".getposition.ClickRecordActivity"
            android:exported="false"
            android:label="无障碍点击记录"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".oneclick.OneClick200Activity"
            android:exported="false"
            android:label="延迟点击 200,200" />
        <activity
            android:name=".golbal_view.GlobalTouchPassThroughActivity"
            android:exported="false"
            android:label="全局放行记录" />

        <service
            android:name=".get_click_and_picture.MediaProjectionForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <service
            android:name=".golbal_view.GlobalTouchPassThroughService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <activity
            android:name=".replay.GlobalTouchReplayActivity"
            android:exported="false"
            android:label="全局点击回放" />
