            android:label="播放数据库操作 Root 版" />
        <activity
            android:name=".golbal_view_advanced.GlobalTouchAdvancedActivity"
            android:exported="false"
            android:label="全局放行记录升级版" />
        <activity
            android:name=".teach.global_view_advanced.GlobalTouchAdvancedTeachIndexActivity"
            android:exported="false"
            android:label="全局放行记录教学导航" />
        <activity
            android:name=".teach.global_view_advanced.GlobalTouchAdvancedTeachDetailActivity"
            android:exported="false"
            android:label="教学详情" />
        <activity
            android:name=".teach.global_view_advanced.GlobalTouchAdvancedPracticeActivity"
            android:exported="false"
            android:label="可运行练习" />

        <service
            android:name=".golbal_view.GlobalTouchService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".golbal_view_advanced.GlobalTouchAdvancedService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".getposition.BackgroundClickService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".getposition.TouchInterceptorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".getposition.BackgroundRecordService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".getposition.ClickAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
        <service
            android:name=".getposition.ClickRecordService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config_record" />
        </service>

        <receiver
            android:name=".golbal_view.ClickBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.chapter07.GET_CLICK" />
                <action android:name="com.example.chapter07.GET_NEXT_CLICK" />
                <action android:name="com.example.chapter07.CLEAR_CLICK_HISTORY" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".golbal_view.ClickCoordinateProvider"
            android:authorities="com.example.chapter07.clickprovider"
            android:enabled="true"
            android:exported="true"
            android:grantUriPermissions="true" />
    </application>

</manifest>