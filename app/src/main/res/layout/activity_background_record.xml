<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="后台点击记录"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <!-- 服务状态 -->
        <TextView
            android:id="@+id/tv_service_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="○ 无障碍服务：检测中..."
            android:textSize="16sp"
            android:layout_marginBottom="10dp"/>

        <!-- 今日记录数 -->
        <TextView
            android:id="@+id/tv_today_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="今日记录: 0 条"
            android:textSize="16sp"
            android:layout_marginBottom="10dp"/>

        <!-- 日期选择 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btn_view_dates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="查看所有会话"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- 选中日期的记录数 -->
        <TextView
            android:id="@+id/tv_record_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="会话记录数: 0 条"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginBottom="10dp"/>

        <!-- 当前会话信息 -->
        <TextView
            android:id="@+id/tv_current_session"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="当前会话: 未创建"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginBottom="15dp"/>

        <!-- 操作按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btn_save_session"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="保存并开始记录"
                android:textSize="16sp"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btn_start_record"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="开始后台记录（当前会话）"
                android:textSize="16sp"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btn_stop_record"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="停止记录"
                android:textSize="16sp"
                android:enabled="false"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btn_clear_today"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="清空今日记录"
                android:textSize="16sp"/>
        </LinearLayout>

        <!-- 日志区域 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="日志"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="#1A000000"
            android:padding="8dp">

            <TextView
                android:id="@+id/tv_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="等待开始记录..."
                android:textSize="12sp"
                android:textColor="#333333"
                android:fontFamily="monospace"/>
        </ScrollView>

        <!-- 返回按钮 -->
        <Button
            android:id="@+id/btn_return"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="返回"
            android:textSize="16sp"
            android:layout_marginTop="20dp"/>

        <!-- 说明 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="说明：\n1. 开始记录后，点击屏幕任意位置\n2. 点击位置会保存到今日数据库\n3. 可随时停止或查看历史记录\n4. 记录按日期分开保存"
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_marginTop="20dp"/>
    </LinearLayout>
</ScrollView>
