<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_get_picture_around.xml

    页面结构：
    - 最顶部：状态 TextView，显示当前截屏服务运行状态
    - 中间：调试信息 TextView，显示点击坐标和所有操作日志（可滚动）
    - 底部：操作按钮区域（申请授权、清除日志）
    - 全页面：可点击区域，模拟收到全局点击坐标
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_pa_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <!-- 页面标题 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="截取点击点附近图像"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#333333" />

    <!-- 当前截屏状态 -->
    <TextView
        android:id="@+id/tv_pa_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="截屏服务：未启动"
        android:textSize="16sp"
        android:textColor="#D32F2F"
        android:padding="12dp"
        android:background="#FFEBEE" />

    <!-- 点击坐标和操作日志（ScrollView 包裹，避免内容过多） -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:background="#FFFFFF"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_pa_click_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="点击坐标：无"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:textColor="#333333" />
    </ScrollView>

    <!-- 操作按钮区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <!-- 申请截屏授权按钮 -->
        <Button
            android:id="@+id/btn_pa_request_projection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="申请截屏授权"
            android:textSize="14sp" />

        <!-- 清除日志按钮 -->
        <Button
            android:id="@+id/btn_pa_clear_log"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="清除日志"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 使用说明 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text='使用说明：&#10;1. 点击“申请截屏授权”，在弹出的对话框中选择“开始截屏”&#10;2. 授权成功后，在任意界面点击任意位置&#10;3. 系统将以点击坐标为中心，截取周围 100×100 像素区域&#10;4. 截图自动保存到应用内部存储目录，带时间戳命名'
        android:textSize="12sp"
        android:textColor="#666666"
        android:padding="8dp"
        android:background="#FAFAFA" />

</LinearLayout>
