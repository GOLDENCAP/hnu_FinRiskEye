<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_detail_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="这个类要学什么"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#3F51B5" />

        <TextView
            android:id="@+id/tv_detail_focus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#444444"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="实现思路 / API / 语法说明"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#3F51B5" />

        <TextView
            android:id="@+id/tv_detail_explanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#444444"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="举一反三 / 对比扩展"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#3F51B5" />

        <TextView
            android:id="@+id/tv_detail_examples"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#444444"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btn_open_practice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="进入对应可运行练习" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="对应练习"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FF7043" />

        <TextView
            android:id="@+id/tv_detail_practice_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tv_detail_practice_requirement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#444444"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="输出要求 / 量化评判标准"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FF7043" />

        <TextView
            android:id="@+id/tv_detail_expected_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#444444"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
