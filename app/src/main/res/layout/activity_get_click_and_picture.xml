<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="点击记录 + 周围截图"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="输入自定义文件夹名后启动。每次点击会记录坐标、保存该时刻周围图片，并在 0.5 秒后恢复放行模式。" />

        <EditText
            android:id="@+id/et_click_picture_folder_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="自定义文件夹名"
            android:inputType="text"
            android:text="click_picture_session" />

        <Button
            android:id="@+id/btn_click_picture_permission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="申请截屏授权" />

        <Button
            android:id="@+id/btn_click_picture_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="启动点击记录事件" />

        <Button
            android:id="@+id/btn_click_picture_stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="停止事件" />

        <TextView
            android:id="@+id/tv_click_picture_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="状态：未启动"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_click_picture_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="保存位置：/data/user/0/com.example.chapter07/databases/[自定义文件夹名]/" />

    </LinearLayout>
</ScrollView>
