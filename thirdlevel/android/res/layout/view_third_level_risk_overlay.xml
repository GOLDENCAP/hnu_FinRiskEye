<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="420dp"
    android:layout_height="wrap_content"
    android:background="@drawable/third_level_overlay_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/overlayRiskTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/third_level_detecting"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="6dp"
        android:fadeScrollbars="false"
        android:scrollbarStyle="insideInset">

        <TextView
            android:id="@+id/overlayRiskDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/third_level_waiting"
            android:textColor="#F1F1F1"
            android:textIsSelectable="true"
            android:textSize="14sp" />
    </ScrollView>

    <Button
        android:id="@+id/overlayStopButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:minHeight="40dp"
        android:text="@string/third_level_stop" />
</LinearLayout>
