# Local HTTP server
PORT=3100
HOST=0.0.0.0

# Token sent by the Android client. Replace before sharing the service.
RISK_API_TOKEN=replace-with-a-random-test-token

# Provider credentials remain on the server.
AI_API_KEY=replace-with-provider-key
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_MODEL=deepseek-ai/DeepSeek-V3.2
AI_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
AI_ASR_MODEL=FunAudioLLM/SenseVoiceSmall

# Request limits
UPSTREAM_TIMEOUT_MS=12000
# 13s: absorbs real-world vision-model latency variance; must stay below the
# Android client's 15s timeout (see server E2E report, 2026-11-13).
VISION_TIMEOUT_MS=13000
ASR_TIMEOUT_MS=12000
MAX_TEXT_LENGTH=5000
IDEMPOTENCY_TTL_MS=600000

# Stability / hardening (added 2026-11-13)
# Rate limit per minute, keyed by (client token + client IP). Applies only to
# /api/v1/risk/* requests that actually start a new analysis: idempotency cache
# hits are answered first, and /health is never rate limited. 0 disables it.
RATE_LIMIT_PER_MINUTE=60
# Set to 1 only when a trusted reverse proxy (nginx) overwrites
# X-Forwarded-For; otherwise clients could spoof their IP to bypass the limiter.
TRUST_PROXY=0
# How often expired idempotency entries are purged from memory (ms).
IDEMPOTENCY_CLEANUP_INTERVAL_MS=60000
# Max time to wait for in-flight requests when receiving SIGINT/SIGTERM (ms).
SHUTDOWN_TIMEOUT_MS=10000
